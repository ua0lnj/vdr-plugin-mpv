msgid "Recording - can't rewind"
msgstr "Nagrywanie - nie można cofać"

msgid "Recording - can't forwarding"
msgstr "Nagrywanie - nie przewijać"

msgid "Recording - can't seek"
msgstr "Nagrywanie - nie można przeskakiwać"

msgid "Recording - stop record first!"
msgstr "Nagrywanie - najpierw zatrzymaj!"

msgid "Recording Stoped"
msgstr "Nagrywanie zatrzymane"

msgid "Recording - can't next"
msgstr "Nagrywanie - nie można przejść do następnego"

msgid "Recording - can't prev"
msgstr "Nagrywanie - nie można przejść do poprzedniego"

msgid "Not network stream, can't recording!"
msgstr "Nie można nagrać innych niż strumień sieciowy!"

msgid "Recording Started"
msgstr "Nagrywanie rozpoczęte"

